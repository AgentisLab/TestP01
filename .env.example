# Gas Tracker — local server env (copy to .env or export before `node server.mjs`).
# NEVER commit real values. .env is gitignored.

# Browser Google Maps JS API key (referrer-restricted dev key from Alex/Ops).
# Injected to the client at runtime via /config.js — kept out of committed source.
GOOGLE_MAPS_API_KEY_WEB=

# Régie de l'énergie public price API endpoint (RnD confirming exact URL).
# Leave unset to use the labeled dev seed (served as stale). 1-line swap when ready.
# REGIE_API_URL=https://www.regie-energie.qc.ca/...

# Optional overrides
# PORT=5173
# REGIE_TIMEOUT_MS=6000
